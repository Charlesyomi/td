services:
  - type: web
    name: todo-backend
    env: python
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn main:app --host 0.0.0.0 --port 10000
    envVars:
      - key: DATABASE_URL
        sync: true  # This will be set from Render's database
      - key: FRONTEND_ORIGIN
        value: https://your-frontend-url.vercel.app  # Replace with your Vercel URL
    databases:
      - name: todo-db
        databaseName: todo
        user: todo
        plan: free
